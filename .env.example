# Copiar a .env y completar. .env nunca se versiona.

# Label Studio
LS_VERSION=1.23.0
LS_PORT=8081
LS_HOST=
LS_DATOS=/ruta/a/datos
LS_ADMIN_EMAIL=admin@example.org
LS_ADMIN_PASSWORD=
LS_SECRET_KEY=
POSTGRES_PASSWORD=

# Tokens de la API (se emiten con ops/cuenta_servicio.py)
LS_API_KEY=
LS_API_KEY_MATLAB=

# Historial de identificaciones
HISTORIAL_DB_PASSWORD=
HISTORIAL_TOKEN=

# Servidor
CERT_IP=192.0.2.10                 # IP con la que se accede al servidor (va en el certificado)
HOST_UID=1000                      # uid/gid del usuario dueño de resultados/ y modelos/
HOST_GID=1000
GPU_EMBEDDINGS=GPU-00000000-0000-0000-0000-000000000000   # nvidia-smi -L
FOTOS_RAIZ=/label-studio/files/dgxraid/fotos   # carpeta de fotos vista desde los contenedores
ETIQUETAS_PREVIAS=/ruta/a/etiquetas   # carpeta del host con labels.db (migración)
PUERTO_BUSCADOR=4200
